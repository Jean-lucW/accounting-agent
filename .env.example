# Copy to .env and fill in real values. Never commit .env.
# Setup guides for every connector: docs/setup/.
#
# The deploy scripts source this file with bash, so a value containing spaces
# must be quoted: AGENT_GIT_NAME="Accounting agent", not AGENT_GIT_NAME=Accounting agent.

# Claude Code, for headless runs on the server (docs/setup/SERVER.md).
# Either an API key or a Claude subscription token.
ANTHROPIC_API_KEY=
# CLAUDE_CODE_OAUTH_TOKEN=
# Model for headless runs (default opus)
# AGENT_MODEL=opus
# Model for read-only `query` sessions from Slack (default: AGENT_MODEL)
# AGENT_QUERY_MODEL=sonnet

# Xero OAuth 2.0 app (docs/setup/XERO.md)
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_REDIRECT_URI=http://localhost:8400/callback

# Slack app (docs/setup/SLACK.md). The listener needs BOTH tokens:
# the bot token (xoxb-) to read and post, the Socket Mode app token (xapp-)
# to receive events. Every reporting script needs the bot token.
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
# The channel runs report into, when config/group.toml [slack] channel_id is blank
# SLACK_CHANNEL_ID=
# Optional caps (defaults shown)
# SLACK_AGENT_MAX_RUNS=12
# SLACK_AGENT_MAX_QUERIES=20
# SLACK_AGENT_MAX_TURNS=40

# Gmail (docs/setup/GMAIL.md): the OAuth client below; the token is written
# to .gmail/ by: python -m accounting_agent.gmail_auth
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=

# Google Drive (docs/setup/GOOGLE_DRIVE.md): may reuse the Gmail OAuth client
# (leave blank) or have its own; token written to .gdrive/ by:
# python -m accounting_agent.gdrive_auth
GDRIVE_CLIENT_ID=
GDRIVE_CLIENT_SECRET=
# Optional: the Google account to pre-select on the consent screen
GDRIVE_LOGIN_HINT=
# Extra Drive folders the agent may write into (comma-separated IDs), on top
# of [drive] publish_folder_id in config/group.toml.
DRIVE_WRITE_ALLOWLIST=
# 1 turns publishing workbooks to Drive off (they are still built in data/reports/)
# NO_DRIVE_PUBLISH=1

# Revolut Business, READ scope only (docs/setup/REVOLUT.md). One block per
# slug named in config/group.toml [[entities.bank_accounts]] slug = "...".
# Example for slug "holdco":
REVOLUT_HOLDCO_CLIENT_ID=
REVOLUT_HOLDCO_ISSUER=
REVOLUT_HOLDCO_REDIRECT_URI=
# The signing key, as a path to a PEM in .revolut/ (chmod 600) ...
REVOLUT_HOLDCO_PRIVATE_KEY=
# ... or carried here as one line of base64 (wins when both are set):
#   base64 -i privatecert.pem | tr -d '\n'
REVOLUT_HOLDCO_PRIVATE_KEY_B64=
# Optional: public half, to catch a mismatched pair before Revolut rejects it
REVOLUT_HOLDCO_PUBLIC_KEY_B64=
# Optional: 1 to use the Revolut sandbox while testing
# REVOLUT_HOLDCO_SANDBOX=1

# Mercury, one READ ONLY token per business (docs/setup/MERCURY.md).
# Example for slug "opcous":
MERCURY_OPCOUS_KEY=

# Server deployment (docs/setup/SERVER.md): used by deploy/ scripts run on
# the laptop to reach the server.
AGENT_SERVER=
AGENT_SERVER_DIR=/opt/accounting-agent
# Optional ssh key for reaching the server
AGENT_SSH_KEY=
# Author of the commits the server makes when it writes admin rulings back
# AGENT_GIT_NAME="Accounting agent"
# AGENT_GIT_EMAIL=accounting-agent@localhost
# Service that echoes this machine's public IP; deploy/sync-all.sh prints it to
# diagnose an IP allowlist (default https://api.ipify.org)
# AGENT_IP_CHECK_URL=https://api.ipify.org
